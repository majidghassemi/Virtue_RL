# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
sdist/
wheels/
pip-wheel-metadata/
MANIFEST

# --- Virtual environments ---
.venv/
venv/
wheels/
env/
ENV/
.python-version

# --- Credentials (see example.env, which IS committed) ---
.env
!example.env

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Experiment outputs (keep code, not artifacts) ---
runs/
outputs/
logs/
checkpoints/
*.pt
*.pth
*.ckpt
*.tar
nohup.out
*.out
*.log
slurm-*.out

# --- Experiment tracking ---
wandb/
wandb_id.txt
wandb_id_eval.txt
mlruns/
tb_logs/
tensorboard/
events.out.tfevents.*

# --- Results pulled back from the cluster (slurm/deploy.sh --pull) ---
results-remote/

# --- Data / results that should live on the cluster, not in git ---
*.csv
!**/configs/*.csv
# Pulled results: log.csv is the primary training record (METRICS.md calls it the
# source of truth), so it must survive the *.csv rule above. Checkpoints do not --
# they are ~2.9 GB and stay on the cluster / local disk only.
!results/**/log.csv
*.npy
*.npz
*.pkl
*.h5
*.hdf5

# --- Rendered rollouts / figures ---
*.mp4
*.avi
*.gif

# --- macOS noise ---
.DS_Store
**/.DS_Store

# --- Editors ---
.vscode/
.idea/
*.swp
*~

# --- Jupyter ---
.ipynb_checkpoints/
