# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
#     cp example.env .env && chmod 600 .env
#
# Loaded automatically by slurm/env.sh, so every script sees these. Values here
# WIN over the defaults in slurm/env.sh; anything already exported in your shell
# wins over both.
#
# slurm/deploy.sh copies .env to the cluster (mode 600) along with the code, so
# you fill it in once, locally. That is deliberate: syncing to wandb.ai runs on a
# DRAC login node and needs the API key there.

# ── Weights & Biases ──────────────────────────────────────────────────────────
# Your key: https://wandb.ai/authorize
# Only needed where you run slurm/sync_wandb.sh. Training itself is offline and
# needs no credentials at all.
WANDB_API_KEY=

# Your wandb username or team. Leave blank to use your account default.
WANDB_ENTITY=

# Where runs land. Change only if you want a separate project.
WANDB_PROJECT=virtue_rl

# ── Cluster (for slurm/deploy.sh, which runs on your LOCAL machine) ───────────
# Your DRAC/Alliance username.
DRAC_USER=

# Login host. Rorqual is the CPU cluster these scripts target.
DRAC_CLUSTER=rorqual.alliancecan.ca

# Where the code lives on the cluster. Code in $HOME (small, backed up); all
# output goes to $SCRATCH — see slurm/env.sh.
DRAC_REMOTE_DIR=~/Virtue_RL

# ── SLURM ─────────────────────────────────────────────────────────────────────
# Your PI's allocation account and where job mail goes.
ACCOUNT=def-mcrowley
MAIL_USER=

# ── Optional overrides (see slurm/env.sh for the full set) ───────────────────
# WALLTIME=24:00:00
# CPUS=8
# MEM=8G
