# Copy to .env and fill in:   cp example.env .env
# .env is gitignored. sync.sh copies it to the cluster along with the code.

# Where to sync to. REMOTE_DIR holds everything: code, venv, runs, logs, wandb.
REMOTE_HOST=prab@rorqual.alliancecan.ca
REMOTE_DIR=/home/prab/links/scratch/virtue_rl

# SLURM
ACCOUNT=def-mcrowley
MAIL_USER=

# Weights & Biases. Key from https://wandb.ai/authorize
# Only needed for slurm/sync_wandb.sh; training itself runs offline.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=virtue_rl
