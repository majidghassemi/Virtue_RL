# Copy to .env and fill in:   cp example.env .env
# .env is gitignored; sync.sh copies it to the cluster (mode 600) with the code.
# Read by sociapl/cc_env.sh. Precedence: shell environment > .env > script defaults.

# Where to sync to. REMOTE_DIR must be an ABSOLUTE path and holds code + runs + wandb.
REMOTE_HOST=prab@rorqual.alliancecan.ca
REMOTE_DIR=/home/prab/links/scratch/virtue_rl

# SLURM. submit.sh injects these as --account / --mail-user, overriding the
# placeholder #SBATCH lines in the grid scripts. MAIL_USER blank = no job mail.
ACCOUNT=def-mcrowley
MAIL_USER=

# Python environment built by sociapl/setup_cc.sh (outside the repo on purpose,
# so sync.sh can never overwrite it). Override only if you keep it elsewhere.
#VENV=/home/prab/venvs/virtue_rl

# Weights & Biases. Key from https://wandb.ai/authorize
# Training runs offline and needs no key; only sync_wandb.sh does.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=virtue_rl
